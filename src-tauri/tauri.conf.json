{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrayBrowser",
  "mainBinaryName": "GrayBrowser",
  "version": "0.10.5",
  "identifier": "com.grayb.graybrowser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GrayBrowser",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "Japanese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFMjMzMTVBM0Y2QzExQTcKUldTbkVXdy9XakVqanBvS3lKdTE4eWVRZ1UwUWoxVHRTRXEyR3pjQndiNVFjQWlzbFRxTk1mdHYK",
      "endpoints": ["https://github.com/becchi78/GrayBrowser/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
